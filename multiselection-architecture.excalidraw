      "locked": false,
      "fontSize": 25,
      "fontFamily": 1,
      "text": "ALL-OR-NOTHING CONSTRAINT\nIf one selected target is unsupported, disable or reject the complete command and explain why. Never apply a partial group operation.",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "ALL-OR-NOTHING CONSTRAINT\nIf one selected target is unsupported, disable or reject the complete command and explain why. Never apply a partial group operation.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hld-header",
      "type": "text",
      "x": 105,
      "y": 3900,
      "width": 980,
      "height": 44,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
