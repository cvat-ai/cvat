    {
      "id": "operations-single-text",
      "type": "text",
      "x": 1985,
      "y": 2775,
      "width": 490,
      "height": 750,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aaC",
      "roundness": null,
      "seed": 1049,
      "version": 1,
      "versionNonce": 2049,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786350000000,
      "link": null,
      "locked": false,
      "fontSize": 22,
      "fontFamily": 1,
      "text": "NOT MULTI-OBJECT\n\nSPLIT\nRemains a single-object operation.\n\nWHY\nSplit transforms one source object\ninto multiple results. It does not\nmap cleanly to one command over\nan arbitrary selected set.\n\nINITIAL LIMITS\nResize and rotate also stay\nsingle-object in the first delivery.\n\nThe persistent selection remains\navailable, but these commands act\nonly when one compatible object\nis the operation target.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NOT MULTI-OBJECT\n\nSPLIT\nRemains a single-object operation.\n\nWHY\nSplit transforms one source object\ninto multiple results. It does not\nmap cleanly to one command over\nan arbitrary selected set.\n\nINITIAL LIMITS\nResize and rotate also stay\nsingle-object in the first delivery.\n\nThe persistent selection remains\navailable, but these commands act\nonly when one compatible object\nis the operation target.",
      "autoResize": true,
      "lineHeight": 1.2
    },
