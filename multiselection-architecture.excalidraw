    {
      "id": "hld-timeline-text",
      "type": "text",
      "x": 1725,
      "y": 4900,
      "width": 745,
      "height": 1000,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aaP",
      "roundness": null,
      "seed": 1062,
      "version": 1,
      "versionNonce": 2062,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786350000000,
      "link": null,
      "locked": false,
      "fontSize": 23,
      "fontFamily": 1,
      "text": "INDICATIVE PLAN AND TIMELINE\nNot a delivery commitment; validate against\nteam capacity and review feedback.\n\nMILESTONE 0 - Design agreement\n1-2 engineering days\nConfirm scope, operation matrix, APIs, and\nunsupported cases.\n\nMILESTONE 1 - Phase 1 MVP\n5-7 engineering days\nSelection, movement, Delete, Copy/Paste,\nCore batches, and history boundaries.\n\nMILESTONE 2 - Stabilization\n2-3 engineering days\nLifecycle handling, manual coverage, E2E\nscenarios, regressions, and review fixes.\n\nMILESTONE 3 - Phase 2 commands\n5-8 engineering days\nLabel, group, join, lock/occluded, z-order.\nMay be split into separate pull requests.\n\nMILESTONE 4 - Phase 3 design spikes\n2-4 engineering days per operation\nMerge and propagation need independent\ncompatibility and conflict designs before\nimplementation estimates are committed.\n\nDEPENDENCIES\nAgreement on UX feedback, Core history API,\nobject capability rules, and test environment.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "INDICATIVE PLAN AND TIMELINE\nNot a delivery commitment; validate against\nteam capacity and review feedback.\n\nMILESTONE 0 - Design agreement\n1-2 engineering days\nConfirm scope, operation matrix, APIs, and\nunsupported cases.\n\nMILESTONE 1 - Phase 1 MVP\n5-7 engineering days\nSelection, movement, Delete, Copy/Paste,\nCore batches, and history boundaries.\n\nMILESTONE 2 - Stabilization\n2-3 engineering days\nLifecycle handling, manual coverage, E2E\nscenarios, regressions, and review fixes.\n\nMILESTONE 3 - Phase 2 commands\n5-8 engineering days\nLabel, group, join, lock/occluded, z-order.\nMay be split into separate pull requests.\n\nMILESTONE 4 - Phase 3 design spikes\n2-4 engineering days per operation\nMerge and propagation need independent\ncompatibility and conflict designs before\nimplementation estimates are committed.\n\nDEPENDENCIES\nAgreement on UX feedback, Core history API,\nobject capability rules, and test environment.",
      "autoResize": true,
      "lineHeight": 1.2
    }
  ],
