    {
      "id": "operations-phase-2-text",
      "type": "text",
      "x": 755,
      "y": 2775,
      "width": 490,
      "height": 750,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
