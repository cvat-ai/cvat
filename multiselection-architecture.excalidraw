      "locked": false
    },
    {
      "id": "operations-phase-3-text",
      "type": "text",
      "x": 1370,
      "y": 2775,
      "width": 490,
      "height": 750,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aaA",
      "roundness": null,
      "seed": 1047,
      "version": 1,
      "versionNonce": 2047,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786350000000,
      "link": null,
      "locked": false,
      "fontSize": 22,
      "fontFamily": 1,
      "text": "PHASE 3 - SPECIALIZED DESIGN\n\nMERGE\nUse operation-specific shape and\nlabel validation.\n\nRESIZE / ROTATE\nRemain single-object operations\ninitially.\n\nPROPAGATE\nRequire a separate frame-range\nand conflict design.\n\nDelivery rule:\nThese operations are added only\nafter their individual constraints\nand failure behavior are defined.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PHASE 3 - SPECIALIZED DESIGN\n\nMERGE\nUse operation-specific shape and\nlabel validation.\n\nRESIZE / ROTATE\nRemain single-object operations\ninitially.\n\nPROPAGATE\nRequire a separate frame-range\nand conflict design.\n\nDelivery rule:\nThese operations are added only\nafter their individual constraints\nand failure behavior are defined.",
      "autoResize": true,
      "lineHeight": 1.2
    },
    {
